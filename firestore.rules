rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    // Admins: presence of admins/{uid} makes that user an admin.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Account status: 'pending' (requested to join), 'active' or 'disabled'.
    // Older account documents only carry disabled: true or false.
    function acctStatus(d) {
      return d.get('status', d.get('disabled', false) == true ? 'disabled' : 'active');
    }
    // Active means an admin approved the account (or never disabled it). People who used the app
    // before join approval have no account document but do have a profile, so they stay active.
    // Anyone new has neither until they ask to join, and stays blocked until an admin approves them.
    function isActive(uid) {
      let p = /databases/$(database)/documents/accounts/$(uid);
      return exists(p)
        ? acctStatus(get(p).data) == 'active'
        : exists(/databases/$(database)/documents/profiles/$(uid));
    }
    // The signed-in user writing is not disabled. Added to every write of a user's own data.
    function active() { return signedIn() && isActive(request.auth.uid); }

    // Who is an admin. Anyone signed in can read it, so the app knows its own status.
    // Only an existing admin can add or remove admins, and nobody can remove themselves,
    // so the last admin can't lock everyone out. The first admin is created in the console.
    match /admins/{uid} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['by', 'at'])
        && request.resource.data.by == request.auth.uid;
      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    // Account status. The owner can read their own; admins can read all.
    match /accounts/{uid} {
      allow read: if isMe(uid) || isAdmin();
      // A new user asks to join: only the pending state, with what an admin needs to recognise them,
      // and whether they signed up as a trainer.
      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly(['status', 'name', 'email', 'photo', 'requested', 'trainer'])
        && (!('trainer' in request.resource.data) || request.resource.data.trainer is bool)
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.photo is string && request.resource.data.photo.size() <= 1000
        && request.resource.data.requested == request.time;
      // Admins approve, decline (disable) or enable accounts, never their own.
      allow create, update: if isAdmin() && uid != request.auth.uid
        && request.resource.data.keys().hasOnly(['status', 'disabled', 'by', 'at', 'name', 'email', 'photo', 'requested', 'trainer'])
        && request.resource.data.status in ['active', 'disabled']
        && request.resource.data.disabled == (request.resource.data.status == 'disabled')
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
    }

    // Record of admin actions. Admins can add entries and read them; nobody can change or delete them.
    match /audit/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['action', 'target', 'name', 'by', 'at'])
        && request.resource.data.by == request.auth.uid;
    }

    // Exercise catalogue, keyed by the exercise name as a slug. Each entry can carry a display name
    // (an admin rename; the data keeps the original name), a YouTube video id, and whether an admin
    // added the exercise. Everyone signed in can read it; only admins can change it.
    match /exercises/{slug} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && active()
        && request.resource.data.keys().hasOnly(['name', 'display', 'youtube', 'added', 'updatedBy', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && (!('display' in request.resource.data) || (request.resource.data.display is string && request.resource.data.display.size() > 0 && request.resource.data.display.size() <= 80))
        && (!('youtube' in request.resource.data) || (request.resource.data.youtube is string && request.resource.data.youtube.matches('[A-Za-z0-9_-]{11}')))
        && (!('added' in request.resource.data) || request.resource.data.added is bool)
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isAdmin() && active();
    }

    // A buddy link is an accepted request in either direction.
    function accepted(a, b) {
      let p = /databases/$(database)/documents/requests/$(a + '_' + b);
      return exists(p) && get(p).data.status == 'accepted';
    }
    function isBuddy(other) {
      return signedIn() && (accepted(request.auth.uid, other) || accepted(other, request.auth.uid));
    }

    // Who may act as my trainer. Only I can add trainers to my own list.
    // A trainer can take themselves off it ("Stop training"), and change nothing else.
    match /coaching/{uid} {
      allow read: if isMe(uid) || (signedIn() && request.auth.uid in resource.data.trainers);
      allow write: if isMe(uid) && active()
        && request.resource.data.trainers is list
        && request.resource.data.trainers.size() <= 10;
      allow update: if active() && request.auth.uid in resource.data.trainers
        && request.resource.data.keys().hasOnly(['trainers', 'updated'])
        && request.resource.data.trainers == resource.data.trainers.removeAll([request.auth.uid]);
    }

    // Is this user marked as a trainer on their profile?
    function isTrainer(u) {
      let p = /databases/$(database)/documents/profiles/$(u);
      return exists(p) && get(p).data.get('trainer', false) == true;
    }

    // Offers to train. Id is "{trainer}_{member}". Only someone marked as a trainer can send one.
    // The member accepts by adding the trainer to their own coaching list, then deletes the offer.
    // Either side can delete it (cancel, decline or tidy up).
    match /coachOffers/{id} {
      allow read: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if active() && isTrainer(request.auth.uid)
        && request.resource.data.keys().hasOnly(['from', 'to', 'created'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.created == request.time;
      allow delete: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    function isTrainerOf(uid) {
      let p = /databases/$(database)/documents/coaching/$(uid);
      return signedIn() && exists(p) && request.auth.uid in get(p).data.trainers;
    }

    // Today's session (id "{date}_d{day}[_{plan}]"), written by a trainer: the date must match the id,
    // the session must say who logged it, and the date must be today somewhere in the world
    // (UTC-12 to UTC+14, so from 14 hours before that date starts in UTC to 36 hours after).
    function trainerToday(docId) {
      let sd = docId.split('_')[0];
      let p = sd.split('-');
      let start = timestamp.date(int(p[0]), int(p[1]), int(p[2]));
      return request.resource.data.date == sd
        && request.resource.data.coach.uid == request.auth.uid
        && request.time > start - duration.value(14, 'h')
        && request.time < start + duration.value(36, 'h');
    }

    // Workout log. The owner has full access.
    // A trainer they chose can read it, write plans, and log or change today's workout. Never other days, and never deletes.
    match /users/{uid}/log/{docId} {
      allow read: if isMe(uid) || isTrainerOf(uid);
      // Writes also need the writer's account to be active (not disabled by an admin).
      allow write: if isMe(uid) && active();
      allow write: if isTrainerOf(uid) && active() && (docId.matches('plan_.*') || docId == 'coach');
      allow create, update: if isTrainerOf(uid) && active()
        && docId.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}_d[1-7](_.*)?')
        && trainerToday(docId);
    }

    // Name, nickname, photo, Instagram handle, bio and whether they are a trainer. Anyone signed in can look up one profile by id.
    // Only admins can list profiles, for the admin screen's user list.
    match /profiles/{uid} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow write: if isMe(uid) && active()
        && request.resource.data.keys().hasOnly(['name', 'photo', 'nick', 'ig', 'bio', 'custom', 'updated', 'trainer'])
        && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 160))
        && (!('trainer' in request.resource.data) || request.resource.data.trainer is bool);
    }

    // Member list for "Find New Buddies": a small card per user. Everyone is listed
    // unless they turn it off, which deletes their card. Only the owner can write it.
    match /directory/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 50;
      allow create, update: if isMe(uid) && active()
        && request.resource.data.keys().hasOnly(['name', 'nick', 'bio', 'photo', 'seen', 'trainer'])
        && (!('trainer' in request.resource.data) || request.resource.data.trainer is bool)
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.nick is string && request.resource.data.nick.size() <= 40
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 80
        && request.resource.data.photo is string && request.resource.data.photo.size() <= 20000
        && request.resource.data.seen is string && request.resource.data.seen.size() == 10;
      allow delete: if isMe(uid) && active();
    }

    // Email lookup for "add by email". Exact match only, no listing.
    match /emails/{email} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if active()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid'])
        && request.auth.token.email.lower() == email;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Buddy requests. Id is "{from}_{to}".
    match /requests/{id} {
      allow read: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if active()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['from', 'to', 'status', 'created']);
      // Only the receiver can accept, and only the status can change.
      allow update: if active()
        && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'accepted';
      // Either side can cancel, decline or unfriend.
      allow delete: if active()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // Global leaderboard card: name, a small photo and the numbers it ranks by. Period fields carry
    // their week or month in the name (ww_20260921), so the field set changes each week; the rules
    // cap its size instead of listing keys. Only written while sharing and "global" are both on.
    match /board/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 50;
      allow create, update: if isMe(uid) && active()
        && request.resource.data.size() <= 24
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.photo is string && request.resource.data.photo.size() <= 20000
        && request.resource.data.total is int;
      // Leaving the board is always allowed, even for a disabled account.
      allow delete: if isMe(uid);
    }

    // Is this user one of my chosen trainers? (My coaching list names them.)
    function hasTrainer(t) {
      let p = /databases/$(database)/documents/coaching/$(request.auth.uid);
      return signedIn() && exists(p) && t in get(p).data.trainers;
    }
    function validWhen(d) {
      return d.date is string && d.date.size() == 10 && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.start is string && d.start.size() == 5 && d.start.matches('[0-9]{2}:[0-9]{2}')
        && d.dur is int && d.dur >= 15 && d.dur <= 240;
    }

    // Calendar entries. Everyone in `members` can read them and they show on each calendar.
    //   solo:  just me, confirmed.
    //   train: a trainee's request to a trainer they chose starts pending (the trainer, `to`, answers);
    //          a trainer scheduling a trainee of theirs is confirmed straight away.
    //   buddy: a request to an accepted buddy, pending until they (`to`) answer.
    // Only the receiver can change the status of a pending entry; either member can delete it.
    match /events/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if active()
        && request.resource.data.keys().hasOnly(['kind', 'members', 'from', 'to', 'trainer', 'date', 'start', 'dur', 'title', 'status', 'created'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members
        && validWhen(request.resource.data)
        && request.resource.data.title is string && request.resource.data.title.size() <= 60
        && request.resource.data.created == request.time
        && (
          (request.resource.data.kind == 'solo'
            && request.resource.data.members.size() == 1
            && request.resource.data.status == 'confirmed'
            && !('to' in request.resource.data))
          || (request.resource.data.kind in ['train', 'buddy']
            && request.resource.data.members.size() == 2
            && request.resource.data.to is string
            && request.resource.data.to != request.auth.uid
            && request.resource.data.members.hasAll([request.auth.uid, request.resource.data.to])
            && (
              (request.resource.data.kind == 'buddy'
                && request.resource.data.status == 'pending'
                && !('trainer' in request.resource.data)
                && isBuddy(request.resource.data.to))
              || (request.resource.data.kind == 'train'
                && request.resource.data.status == 'pending'
                && request.resource.data.get('trainer', '') == request.resource.data.to
                && hasTrainer(request.resource.data.to))
              || (request.resource.data.kind == 'train'
                && request.resource.data.status == 'confirmed'
                && request.resource.data.get('trainer', '') == request.auth.uid
                && isTrainerOf(request.resource.data.to))
            ))
        );
      allow update: if active()
        && request.auth.uid in resource.data.members
        && resource.data.status == 'pending'
        && resource.data.get('to', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['confirmed', 'declined'];
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    // A confirmed training session as a bare time block (no title, no trainee named in the app), so a trainer's
    // trainees can see when the trainer is busy. Written by the trainer; the trainer or the trainee can remove it.
    match /slots/{id} {
      allow read: if signedIn() && (resource.data.trainer == request.auth.uid || hasTrainer(resource.data.trainer));
      allow create: if active()
        && request.resource.data.keys().hasOnly(['trainer', 'members', 'date', 'start', 'dur'])
        && request.resource.data.trainer == request.auth.uid
        && request.resource.data.members is list && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && validWhen(request.resource.data);
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    // A trainer's weekly working hours: { hours: { '1': ['06:00-10:00'], ... }, updated }. The trainer writes it;
    // trainees who chose them can read it.
    match /avail/{uid} {
      allow read: if isMe(uid) || hasTrainer(uid);
      allow create, update: if isMe(uid) && active()
        && request.resource.data.keys().hasOnly(['hours', 'updated'])
        && request.resource.data.hours is map && request.resource.data.hours.size() <= 7
        && request.resource.data.updated is int;
      allow delete: if isMe(uid);
    }

    // Who is working out right now: a small card while someone's workout clock runs. Any member can read the
    // list. 'until' is the start plus the time limit, so a card nobody deleted stops showing on its own.
    match /live/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 50;
      allow create, update: if isMe(uid) && active()
        && request.resource.data.keys().hasOnly(['name', 'title', 't', 't0', 'until', 'at', 'ex', 'done', 'of', 'plan'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.title is string && request.resource.data.title.size() <= 60
        && request.resource.data.t is string && request.resource.data.t.size() <= 20
        && request.resource.data.ex is string && request.resource.data.ex.size() <= 80
        && request.resource.data.plan is string && request.resource.data.plan.size() <= 80
        && request.resource.data.t0 is int && request.resource.data.until is int && request.resource.data.at is int
        && request.resource.data.done is int && request.resource.data.of is int;
      // Leaving is always allowed, even for a disabled account.
      allow delete: if isMe(uid);
    }

    // Progress summary. The app only writes stats here while sharing is on;
    // turning sharing off overwrites it with { sharing: false }.
    match /shared/{uid} {
      allow read: if isMe(uid) || isBuddy(uid);
      allow write: if isMe(uid) && active();
    }
  }
}
