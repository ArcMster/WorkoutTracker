rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    // Admins: presence of admins/{uid} makes that user an admin.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Account status: 'pending' (requested to join), 'active' or 'disabled'.
    // Older account documents only carry disabled: true or false.
    function acctStatus(d) {
      return d.get('status', d.get('disabled', false) == true ? 'disabled' : 'active');
    }
    // Active means an admin approved the account (or never disabled it). People who used the app
    // before join approval have no account document but do have a profile, so they stay active.
    // Anyone new has neither until they ask to join, and stays blocked until an admin approves them.
    function isActive(uid) {
      let p = /databases/$(database)/documents/accounts/$(uid);
      return exists(p)
        ? acctStatus(get(p).data) == 'active'
        : exists(/databases/$(database)/documents/profiles/$(uid));
    }
    // The signed-in user writing is not disabled. Added to every write of a user's own data.
    function active() { return signedIn() && isActive(request.auth.uid); }

    // Who is an admin. Anyone signed in can read it, so the app knows its own status.
    // Only an existing admin can add or remove admins, and nobody can remove themselves,
    // so the last admin can't lock everyone out. The first admin is created in the console.
    match /admins/{uid} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['by', 'at'])
        && request.resource.data.by == request.auth.uid;
      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    // Account status. The owner can read their own; admins can read all.
    match /accounts/{uid} {
      allow read: if isMe(uid) || isAdmin();
      // A new user asks to join: only the pending state, with what an admin needs to recognise them.
      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly(['status', 'name', 'email', 'photo', 'requested'])
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.photo is string && request.resource.data.photo.size() <= 1000
        && request.resource.data.requested == request.time;
      // Admins approve, decline (disable) or enable accounts, never their own.
      allow create, update: if isAdmin() && uid != request.auth.uid
        && request.resource.data.keys().hasOnly(['status', 'disabled', 'by', 'at', 'name', 'email', 'photo', 'requested'])
        && request.resource.data.status in ['active', 'disabled']
        && request.resource.data.disabled == (request.resource.data.status == 'disabled')
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
    }

    // Record of admin actions. Admins can add entries and read them; nobody can change or delete them.
    match /audit/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['action', 'target', 'name', 'by', 'at'])
        && request.resource.data.by == request.auth.uid;
    }

    // Exercise catalogue, keyed by the exercise name as a slug. Each entry can carry a display name
    // (an admin rename; the data keeps the original name), a YouTube video id, and whether an admin
    // added the exercise. Everyone signed in can read it; only admins can change it.
    match /exercises/{slug} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && active()
        && request.resource.data.keys().hasOnly(['name', 'display', 'youtube', 'added', 'updatedBy', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && (!('display' in request.resource.data) || (request.resource.data.display is string && request.resource.data.display.size() > 0 && request.resource.data.display.size() <= 80))
        && (!('youtube' in request.resource.data) || (request.resource.data.youtube is string && request.resource.data.youtube.matches('[A-Za-z0-9_-]{11}')))
        && (!('added' in request.resource.data) || request.resource.data.added is bool)
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isAdmin() && active();
    }

    // A buddy link is an accepted request in either direction.
    function accepted(a, b) {
      let p = /databases/$(database)/documents/requests/$(a + '_' + b);
      return exists(p) && get(p).data.status == 'accepted';
    }
    function isBuddy(other) {
      return signedIn() && (accepted(request.auth.uid, other) || accepted(other, request.auth.uid));
    }

    // Who may act as my trainer. Only I can change my own list.
    match /coaching/{uid} {
      allow read: if isMe(uid) || (signedIn() && request.auth.uid in resource.data.trainers);
      allow write: if isMe(uid) && active()
        && request.resource.data.trainers is list
        && request.resource.data.trainers.size() <= 10;
    }

    function isTrainerOf(uid) {
      let p = /databases/$(database)/documents/coaching/$(uid);
      return signedIn() && exists(p) && request.auth.uid in get(p).data.trainers;
    }

    // Workout log. The owner has full access.
    // A trainer they chose can read it and write plans, never logged sets.
    match /users/{uid}/log/{docId} {
      allow read: if isMe(uid) || isTrainerOf(uid);
      // Writes also need the writer's account to be active (not disabled by an admin).
      allow write: if isMe(uid) && active();
      allow write: if isTrainerOf(uid) && active() && (docId.matches('plan_.*') || docId == 'coach');
    }

    // Name, nickname, photo, Instagram handle and bio. Anyone signed in can look up one profile by id.
    // Only admins can list profiles, for the admin screen's user list.
    match /profiles/{uid} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow write: if isMe(uid) && active()
        && request.resource.data.keys().hasOnly(['name', 'photo', 'nick', 'ig', 'bio', 'custom', 'updated'])
        && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 160));
    }

    // Member list for "Find New Buddies": a small card per user. Everyone is listed
    // unless they turn it off, which deletes their card. Only the owner can write it.
    match /directory/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 50;
      allow create, update: if isMe(uid) && active()
        && request.resource.data.keys().hasOnly(['name', 'nick', 'bio', 'photo', 'seen'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.nick is string && request.resource.data.nick.size() <= 40
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 80
        && request.resource.data.photo is string && request.resource.data.photo.size() <= 20000
        && request.resource.data.seen is string && request.resource.data.seen.size() == 10;
      allow delete: if isMe(uid) && active();
    }

    // Email lookup for "add by email". Exact match only, no listing.
    match /emails/{email} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if active()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid'])
        && request.auth.token.email.lower() == email;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Buddy requests. Id is "{from}_{to}".
    match /requests/{id} {
      allow read: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if active()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['from', 'to', 'status', 'created']);
      // Only the receiver can accept, and only the status can change.
      allow update: if active()
        && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'accepted';
      // Either side can cancel, decline or unfriend.
      allow delete: if active()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // Progress summary. The app only writes stats here while sharing is on;
    // turning sharing off overwrites it with { sharing: false }.
    match /shared/{uid} {
      allow read: if isMe(uid) || isBuddy(uid);
      allow write: if isMe(uid) && active();
    }
  }
}
